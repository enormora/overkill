{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "@overkill-dev/assert": ["./packages/assert/assert.entry-point.ts"],
            "@overkill-dev/doubles": ["./packages/doubles/doubles.entry-point.ts"],
            "@overkill-dev/engine": ["./packages/engine/engine.entry-point.ts"],
            "@overkill-dev/reporter-line": ["./packages/reporter-line/reporter-line.entry-point.ts"],
            "@overkill-dev/reporter-benchmark-html": [
                "./packages/reporter-benchmark-html/reporter-benchmark-html.entry-point.ts"
            ],
            "@overkill-dev/test/reporters": ["./packages/test/reporters.entry-point.ts"]
        },
        "rootDir": "..",
        "tsBuildInfoFile": "../target/buildcache/integration-tests.tsbuildinfo",
        "types": ["node"]
    },
    "references": [
        { "path": "./tsconfig.sources.json" }
    ],
    "include": [
        "./integration-tests/**/*.ts",
        "./test-support/run-command-factory.ts",
        "./test-support/collected-run-fixtures.ts",
        "./test-support/run-if-main.ts",
        "./test-support/benchmark-baseline-fixture.ts",
        "./test-support/coverage-transpilation.ts",
        "./test-support/benchmark-html-fixture.ts",
        "./test-support/run-result-factory.ts"
    ]
}
