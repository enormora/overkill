{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "@typescript/typescript6": [
                "../node_modules/typescript/lib/typescript.d.ts"
            ],
            "typescript/sync": [
                "../node_modules/typescript-beta/dist/api/sync/api.d.ts"
            ],
            "typescript/ast": [
                "../node_modules/typescript-beta/dist/ast/index.d.ts"
            ],
            "@overkill-dev/assert": [
                "./packages/assert/assert.entry-point.ts"
            ],
            "@overkill-dev/doubles": [
                "./packages/doubles/doubles.entry-point.ts"
            ],
            "@overkill-dev/engine": [
                "./packages/engine/engine.entry-point.ts"
            ],
            "@overkill-dev/engine/*": [
                "./*"
            ],
            "@overkill-dev/reporter-line": [
                "./packages/reporter-line/reporter-line.entry-point.ts"
            ],
            "@overkill-dev/reporter-benchmark-html": [
                "./packages/reporter-benchmark-html/reporter-benchmark-html.entry-point.ts"
            ],
            "@overkill-dev/test/reporters": [
                "./packages/test/reporters.entry-point.ts"
            ]
        },
        "rootDir": "..",
        "tsBuildInfoFile": "../target/buildcache/tests.tsbuildinfo"
    },
    "references": [
        {
            "path": "./tsconfig.sources.json"
        }
    ],
    "include": [
        "./**/*.test.ts",
        "./test-support/**/*.ts",
        "./integration-tests/**/*.ts",
        "./property/fixtures/property-values-v1.json",
        "./property/fixtures/property-graph-v1.json",
        "./property/fixtures/property-custom-v1.json",
        "./property/fixtures/property-graph-state-v1.json"
    ],
    "exclude": [
        "./**/*.type-test.ts"
    ]
}
