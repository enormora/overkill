{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "@typescript/typescript6": [
                "../node_modules/typescript/lib/typescript.d.ts"
            ],
            "@overkill-dev/assert": [
                "./packages/assert/assert.entry-point.ts"
            ],
            "@overkill-dev/doubles": [
                "./packages/doubles/doubles.entry-point.ts"
            ],
            "@overkill-dev/engine": [
                "./packages/engine/engine.entry-point.ts"
            ],
            "@overkill-dev/engine/*": [
                "./*"
            ],
            "@overkill-dev/reporter-line": [
                "./packages/reporter-line/reporter-line.entry-point.ts"
            ],
            "typescript/sync": [
                "../node_modules/typescript-beta/dist/api/sync/api.d.ts"
            ],
            "typescript/ast": [
                "../node_modules/typescript-beta/dist/ast/index.d.ts"
            ]
        },
        "tsBuildInfoFile": "../target/buildcache/unit-tests.tsbuildinfo",
        "rootDir": "..",
        "types": [
            "node"
        ]
    },
    "references": [
        {
            "path": "./tsconfig.sources.json"
        },
        {
            "path": "./tsconfig.integration-tests.json"
        }
    ],
    "include": [
        "./**/*.test.ts",
        "./test-support/**/*.ts"
    ],
    "exclude": [
        "./**/*.type-test.ts",
        "./integration-tests/**/*.ts"
    ]
}
