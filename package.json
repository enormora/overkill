{
    "name": "overkill",
    "version": "0.0.1",
    "description": "Simple, easy and fast test framework",
    "type": "module",
    "exports": {
        ".": {
            "import": "./target/build/source/index.js"
        }
    },
    "bin": {
        "overkill": "target/build/source/bin.js"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/screendriver/overkill.git"
    },
    "keywords": [
        "test",
        "tests",
        "tdd"
    ],
    "author": "Christian Rackerseder <git@echooff.de>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/screendriver/overkill/issues"
    },
    "homepage": "https://github.com/screendriver/overkill#readme",
    "scripts": {
        "compile": "tsc --build",
        "eslint": "eslint source --ext '.js,.ts' --cache --cache-location './target/.eslintcache'",
        "prettier": "prettier '**/*.(yml|json|yaml|md)'",
        "lint": "npm run eslint && npm run prettier -- --check && ls-lint",
        "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
        "test:unit": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' TS_NODE_PROJECT=source/tsconfig.unit-tests.json uvu 'source' '.*\\.test\\.ts$'"
    },
    "dependencies": {
        "figures": "5.0.0",
        "kleur": "4.1.5",
        "tslib": "2.5.0"
    },
    "devDependencies": {
        "@ls-lint/ls-lint": "1.11.2",
        "@types/sinon": "10.0.13",
        "@typescript-eslint/eslint-plugin": "5.56.0",
        "@typescript-eslint/parser": "5.56.0",
        "eslint": "8.36.0",
        "eslint-config-prettier": "8.8.0",
        "eslint-import-resolver-typescript": "3.5.3",
        "eslint-plugin-functional": "5.0.6",
        "eslint-plugin-import": "2.27.5",
        "eslint-plugin-prettier": "4.2.1",
        "prettier": "2.8.5",
        "sinon": "14.0.2",
        "ts-node": "10.9.1",
        "typescript": "4.9.5",
        "uvu": "0.5.6"
    }
}
