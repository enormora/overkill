{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "source/**/*.test.ts",
        "!source/integration-tests/integration/fixtures/**/*.test.ts",
        "source/integration-tests/integration/fixtures/custom-engine.ts",
        "source/**/*.type-test.ts",
        "source/packages/**/*.ts",
        "source/run/node-command-line-runner.entry-point.ts",
        "source/run/worker-pool-worker.ts",
        "source/test-support/body-plan-implementation.ts",
        "source/reporters/null-reporter.ts",
        "build-benchmark-html.js",
        "source/reporters/benchmark-html-browser.entry-point.ts",
        "dependency-cruiser.config.js",
        "packtory.config.js",
        "overkill.config.ts",
        "tstyche.json"
    ],
    "project": [
        "source/**/*.ts!",
        "*.{js,ts}",
        "!source/**/*.test.ts!",
        "!source/**/*.type-test.ts!"
    ],
    "ignore": [
        "source/integration-tests/integration/fixtures/**/*.test.ts"
    ],
    "ignoreDependencies": [
        "@ls-lint/ls-lint",
        "jscpd"
    ]
}
